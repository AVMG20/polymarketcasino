# Local dev values; production values in the comments.

# SQLite file. Production: /data/casino.sqlite (a Docker volume; the image sets it).
DATABASE_PATH=./data/casino.sqlite

# The hub. Production: https://core.avmg.nl
CORE_URL=http://localhost:3100
PNX_APP_ID=casino
# The app's API key. Production: the same pnx_ key as the casino entry in the hub's BOOTSTRAP_APPS
# (or the key the hub's developer API returned when registering the app).
PNX_APP_KEY=pnx_dev_casino_key_change_me

# 32+ random characters; seals the session cookie. Production: a fresh secret.
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-of-32-plus-chars
# Salts the My Casino floor's luck (which hours are good): server only. Unset: the session password.
PNX_LUCK_SALT=

# lax on localhost and on *.avmg.nl (same site as the hub). none adds Secure; Partitioned for a foreign domain.
PNX_COOKIE_SAMESITE=lax

# GET /api/dev/login?name=Alice. Production: false. It is also refused whenever NODE_ENV=production
# and for any request that is https on a non-localhost host.
PNX_DEV_LOGIN=true

# This app's public origin, for the cover url in the hub manifest. Production: https://casino.avmg.nl
PUBLIC_URL=http://localhost:3200

# Set by the Dockerfile in production; leave unset in dev:
# NODE_ENV=production   turns the dev login off for good and makes the session cookie Secure
# HOST=0.0.0.0
# PORT=3000
# MIGRATIONS_PATH=/app/drizzle   where scripts/migrate.ts finds the SQL (default ./drizzle)
